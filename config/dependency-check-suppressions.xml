<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check suppressions.

  Empty on purpose. A suppression is a decision that a known vulnerability does not apply here,
  and that decision needs a name, a date and a reason attached to it - not a blanket entry added
  to make a build go green. Add one only with all three, and re-read it at the next upgrade.

  Template:

  <suppress until="2027-01-01Z">
    <notes>
      Why this does not apply. Who decided. When it should be reviewed again.
    </notes>
    <packageUrl regex="true">^pkg:maven/com\.example/thing@.*$</packageUrl>
    <cve>CVE-0000-00000</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
