<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>com.hms</groupId>
  <artifactId>hms-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>hms-parent</name>
  <description>Hospital Management System - Maven aggregator</description>

  <modules>
    <module>platform/hms-common</module>
    <module>services/identity-service</module>
    <module>services/gateway</module>
    <module>services/patient-service</module>
    <module>services/laboratory-service</module>
    <module>services/scheduling-service</module>
    <module>services/notification-service</module>
    <module>services/admissions-service</module>
    <module>services/pharmacy-service</module>
    <module>services/billing-service</module>
    <module>services/imaging-service</module>
    <module>services/immunisation-service</module>
    <module>services/interop-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-cloud.version>2025.1.3</spring-cloud.version>
    <springdoc.version>2.8.13</springdoc.version>

    <!-- Ahead of the version Spring Boot 4.0.8 manages (11.0.24), and not a preference: 11.0.24
         carries three CRITICAL advisories, all of them authorization bypasses, all fixed in
         11.0.25.

           CVE-2026-65182 (9.1)  a security constraint for a longer path specified before a more
                                 restrictive one for a shorter sub-path is bypassed
           CVE-2026-68525 (9.1)  authorization bypass in FORM authentication
           CVE-2026-65905 (9.8)  capture-replay against the DIGEST authenticator

         This platform's entire access-control story is per-endpoint authorization, so "the servlet
         container can be talked out of a security constraint" is about as close to the heart of it
         as a dependency CVE gets. Overriding the property is how Spring Boot documents changing a
         managed version; remove it once a Boot release manages 11.0.25 or later. -->
    <tomcat.version>11.0.25</tomcat.version>

    <!-- Analysis tooling. Pinned, because a scanner that changes version under you turns a clean
         build red for reasons nobody changed. -->
    <spotbugs-maven-plugin.version>4.10.4.0</spotbugs-maven-plugin.version>
    <findsecbugs.version>1.14.0</findsecbugs.version>
    <!-- Held at 12.2.2 deliberately. 13.0.0 passes an empty string rather than null when no NVD
         API key is configured, so it cannot update keyless at all - dependency-check#8715, from
         PR #8549, fixed by PR #8716 but not yet released (13.0.0 is still the newest on Maven
         Central). Move forward once a release later than 13.0.0 exists. -->
    <dependency-check-maven.version>12.2.2</dependency-check-maven.version>
    <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
    <pitest-maven.version>1.30.0</pitest-maven.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>
    <spotbugs.threshold>Medium</spotbugs.threshold>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.hms</groupId>
        <artifactId>hms-common</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Test dependencies every module needs. Spring Boot 4 split test auto-configuration into
       per-technology modules, so MockMvc support comes from spring-boot-starter-webmvc-test
       rather than spring-boot-starter-test. -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>

    <!-- CycloneDX SBOM. `mvn -Psbom package -DskipTests`.
         The reactor-wide one lands at target/classes/META-INF/sbom/application.cdx.json - that
         path is the plugin's, not a choice; a `pom`-packaged root writes the aggregate there and
         ignores outputDirectory. Each module also embeds its own SBOM at the same relative path
         inside its jar, which is worth keeping: a deployed artifact then carries its own bill of
         materials.

         Why an SBOM rather than pointing a scanner at the poms: nearly every version here comes
         from the imported spring-boot-dependencies and spring-cloud-dependencies BOMs rather than
         being written in a pom, so a scanner parsing pom.xml has to re-implement Maven's
         resolution to get versions right. Letting Maven emit the resolved graph removes the
         guesswork - it is how both jackson-databind 3.1.5 and the 2.21.5 that arrives
         transitively show up as separate components. -->
    <profile>
      <id>sbom</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <version>${cyclonedx-maven-plugin.version}</version>
            <configuration>
              <outputFormat>json</outputFormat>
              <projectType>application</projectType>
              <schemaVersion>1.5</schemaVersion>
              <!-- Test-only dependencies do not ship, so scanning them turns real findings into
                   noise - the same call the Dependency-Check profile makes with skipTestScope. -->
              <includeTestScope>false</includeTestScope>
            </configuration>
            <executions>
              <execution>
                <id>default</id>
                <phase>package</phase>
                <goals>
                  <goal>makeAggregateBom</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Static analysis: SpotBugs with the FindSecBugs detector pack.
         `mvn -Pquality verify` (or `make sast`). Fails the build on a high-confidence finding
         rather than writing a report nobody opens. -->
    <profile>
      <id>quality</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            <version>${spotbugs-maven-plugin.version}</version>
            <configuration>
              <effort>Max</effort>
              <!-- Medium, for both the report and the gate. The `check` goal reads the XML the
                   `spotbugs` goal wrote, so a lower reporting threshold does not mean a stricter
                   report and a looser gate - it means the gate blocks on everything reported.
                   Medium is the line worth blocking on: Low is inventory (every @Controller is
                   "a Spring endpoint", every User-Agent read is "spoofable"), and a gate that
                   fails on inventory gets switched off. Run `mvn -Pquality verify
                   -Dspotbugs.threshold=Low` for the full sweep. -->
              <threshold>${spotbugs.threshold}</threshold>
              <failOnError>true</failOnError>
              <includeTests>false</includeTests>
              <excludeFilterFile>config/spotbugs-exclude.xml</excludeFilterFile>
              <plugins>
                <plugin>
                  <groupId>com.h3xstream.findsecbugs</groupId>
                  <artifactId>findsecbugs-plugin</artifactId>
                  <version>${findsecbugs.version}</version>
                </plugin>
              </plugins>
            </configuration>
            <executions>
              <!-- Analysis first, at the reporting threshold, so the full XML and HTML exist for
                   a human. `check` then reads that report; it does not re-analyse. -->
              <execution>
                <id>spotbugs-report</id>
                <phase>verify</phase>
                <goals>
                  <goal>spotbugs</goal>
                </goals>
              </execution>
              <execution>
                <id>spotbugs-check</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Dependency vulnerability scanning (OWASP Dependency-Check).
         `mvn -Psecurity verify -DnvdApiKey=...`. Fails on CVSS 7.0 and above - the level at which
         a vulnerable transitive dependency stops being paperwork.

         The key is NOT configured here, and that is the fix for a real outage rather than an
         omission. It used to read `<nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>`, and when the
         environment variable was unset-or-empty - which it is, because the repository secret was
         never populated - the plugin received a zero-length key and died with "Invalid API Key,
         length of 0". An absent key degrades to keyless mode; an empty one is a hard error. The
         plugin already exposes `nvdApiKey` as a user property, so CI passes -DnvdApiKey when it
         has one and passes nothing when it does not.

         Without a key the NVD feed is throttled hard enough to be impractical in CI, so this
         profile is the with-a-key path. The gate that runs unconditionally is Trivy over the
         CycloneDX SBOM produced by the `sbom` profile below. -->
    <profile>
      <id>security</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check-maven.version}</version>
            <configuration>
              <failBuildOnCVSS>7.0</failBuildOnCVSS>
              <formats>
                <format>HTML</format>
                <format>SARIF</format>
                <format>JSON</format>
              </formats>
              <suppressionFiles>
                <suppressionFile>config/dependency-check-suppressions.xml</suppressionFile>
              </suppressionFiles>
              <!-- Test-only dependencies do not ship. Scanning them turns real findings into
                   noise nobody triages. -->
              <skipTestScope>true</skipTestScope>
            </configuration>
            <executions>
              <execution>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Mutation testing (PIT). `mvn -Pmutation test`.
         Line coverage says a line ran; it does not say a test would have noticed if the line were
         wrong. PIT changes the code and checks that something fails. Scoped to the domain and
         service packages - mutating DTOs and controllers produces survivors that nobody should
         write a test for. -->
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest-maven.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>com.hms.*.domain.*</param>
                <param>com.hms.*.service.*</param>
                <param>com.hms.*.device.*</param>
                <param>com.hms.common.*</param>
              </targetClasses>
              <targetTests>
                <param>com.hms.*</param>
              </targetTests>
              <outputFormats>
                <param>HTML</param>
                <param>XML</param>
              </outputFormats>
              <!-- A starting line, not an aspiration. Raise it as the suite earns it; a
                   threshold set above what the suite achieves today just gets ignored. -->
              <mutationThreshold>60</mutationThreshold>
              <timeoutConstant>10000</timeoutConstant>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- API automation. Kept out of the default reactor on purpose: these tests talk HTTP to a
         deployed gateway, so an ordinary `mvn verify` on a developer machine must not try to run
         them. Reachable as `mvn -pl tests/api verify -Pautomation` (or `make test-api`). -->
    <profile>
      <id>automation</id>
      <modules>
        <module>tests/api</module>
      </modules>
    </profile>

    <!-- The layout the self-contained Windows installer is packaged from, and deliberately not the
         default. `mvn package` unchanged still produces the twelve ordinary fat jars that
         Dockerfile.java, scripts/local.sh, scripts/gen-certs.sh and medsync.sh all launch with a
         plain `java -jar` - nothing about the everyday build, CI or the container images moves.

         `mvn -Pthin package` instead produces twelve ~0.3 MB jars with no BOOT-INF/lib at all,
         launched as `java -Dloader.path=lib -jar <service>.jar` against one shared directory.
         The measurement that makes this worth a profile: the twelve fat jars carry 1,246
         dependency entries weighing 995 MB, and among them are only 172 distinct jars weighing
         123 MB. Each fat jar is roughly 84 MB of libraries wrapped around 0.3 MB of MedSync. An
         installer that ships the fat jars ships those libraries twelve times.

         ZIP layout means PropertiesLauncher, which is the launcher that reads `loader.path`; the
         empty <includes> filter is what empties BOOT-INF/lib, since ZIP layout on its own still
         embeds every dependency. The two go together and neither is useful alone. -->
    <profile>
      <id>thin</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.springframework.boot</groupId>
              <artifactId>spring-boot-maven-plugin</artifactId>
              <configuration>
                <layout>ZIP</layout>
                <!-- The jarmode tools jar is a 55 KB diagnostic helper the plugin adds by default.
                     Twelve copies of it is most of a megabyte in aid of a command nobody runs from
                     inside this installer. -->
                <includeTools>false</includeTools>
                <!-- A filter that matches no dependency, which is how this plugin is asked to
                     package none of them. The groupId is not a typo and not a placeholder to fill
                     in later: it exists precisely so that it matches nothing. -->
                <includes>
                  <include>
                    <groupId>com.hms.none</groupId>
                    <artifactId>packaged-separately</artifactId>
                  </include>
                </includes>
              </configuration>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- Services boot a real Postgres/Kafka-free local profile in tests. -->
            <environmentVariables>
              <HMS_TEST>1</HMS_TEST>
            </environmentVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
