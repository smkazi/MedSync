<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.8</version>
    <relativePath/>
  </parent>

  <groupId>com.hms</groupId>
  <artifactId>hms-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>hms-parent</name>
  <description>Hospital Management System - Maven aggregator</description>

  <modules>
    <module>platform/hms-common</module>
    <module>services/identity-service</module>
    <module>services/gateway</module>
    <module>services/patient-service</module>
    <module>services/laboratory-service</module>
    <module>services/scheduling-service</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-cloud.version>2025.1.3</spring-cloud.version>
    <springdoc.version>2.8.13</springdoc.version>

    <!-- Analysis tooling. Pinned, because a scanner that changes version under you turns a clean
         build red for reasons nobody changed. -->
    <spotbugs-maven-plugin.version>4.10.4.0</spotbugs-maven-plugin.version>
    <findsecbugs.version>1.14.0</findsecbugs.version>
    <dependency-check-maven.version>13.0.0</dependency-check-maven.version>
    <pitest-maven.version>1.30.0</pitest-maven.version>
    <pitest-junit5.version>1.2.3</pitest-junit5.version>
    <spotbugs.threshold>Medium</spotbugs.threshold>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.hms</groupId>
        <artifactId>hms-common</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- Test dependencies every module needs. Spring Boot 4 split test auto-configuration into
       per-technology modules, so MockMvc support comes from spring-boot-starter-webmvc-test
       rather than spring-boot-starter-test. -->
  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- Static analysis: SpotBugs with the FindSecBugs detector pack.
         `mvn -Pquality verify` (or `make sast`). Fails the build on a high-confidence finding
         rather than writing a report nobody opens. -->
    <profile>
      <id>quality</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            <version>${spotbugs-maven-plugin.version}</version>
            <configuration>
              <effort>Max</effort>
              <!-- Medium, for both the report and the gate. The `check` goal reads the XML the
                   `spotbugs` goal wrote, so a lower reporting threshold does not mean a stricter
                   report and a looser gate - it means the gate blocks on everything reported.
                   Medium is the line worth blocking on: Low is inventory (every @Controller is
                   "a Spring endpoint", every User-Agent read is "spoofable"), and a gate that
                   fails on inventory gets switched off. Run `mvn -Pquality verify
                   -Dspotbugs.threshold=Low` for the full sweep. -->
              <threshold>${spotbugs.threshold}</threshold>
              <failOnError>true</failOnError>
              <includeTests>false</includeTests>
              <excludeFilterFile>config/spotbugs-exclude.xml</excludeFilterFile>
              <plugins>
                <plugin>
                  <groupId>com.h3xstream.findsecbugs</groupId>
                  <artifactId>findsecbugs-plugin</artifactId>
                  <version>${findsecbugs.version}</version>
                </plugin>
              </plugins>
            </configuration>
            <executions>
              <!-- Analysis first, at the reporting threshold, so the full XML and HTML exist for
                   a human. `check` then reads that report; it does not re-analyse. -->
              <execution>
                <id>spotbugs-report</id>
                <phase>verify</phase>
                <goals>
                  <goal>spotbugs</goal>
                </goals>
              </execution>
              <execution>
                <id>spotbugs-check</id>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Dependency vulnerability scanning (OWASP Dependency-Check).
         `mvn -Psecurity verify` (or `make sca`). Fails on CVSS 7.0 and above - the level at which
         a vulnerable transitive dependency stops being paperwork.

         Needs to fetch the NVD feed on first run, which is slow and rate-limited without a key;
         set NVD_API_KEY (free from nvd.nist.gov) in CI. -->
    <profile>
      <id>security</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.owasp</groupId>
            <artifactId>dependency-check-maven</artifactId>
            <version>${dependency-check-maven.version}</version>
            <configuration>
              <failBuildOnCVSS>7.0</failBuildOnCVSS>
              <formats>
                <format>HTML</format>
                <format>SARIF</format>
                <format>JSON</format>
              </formats>
              <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
              <suppressionFiles>
                <suppressionFile>config/dependency-check-suppressions.xml</suppressionFile>
              </suppressionFiles>
              <!-- Test-only dependencies do not ship. Scanning them turns real findings into
                   noise nobody triages. -->
              <skipTestScope>true</skipTestScope>
            </configuration>
            <executions>
              <execution>
                <phase>verify</phase>
                <goals>
                  <goal>check</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Mutation testing (PIT). `mvn -Pmutation test`.
         Line coverage says a line ran; it does not say a test would have noticed if the line were
         wrong. PIT changes the code and checks that something fails. Scoped to the domain and
         service packages - mutating DTOs and controllers produces survivors that nobody should
         write a test for. -->
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>${pitest-maven.version}</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>${pitest-junit5.version}</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>com.hms.*.domain.*</param>
                <param>com.hms.*.service.*</param>
                <param>com.hms.*.device.*</param>
                <param>com.hms.common.*</param>
              </targetClasses>
              <targetTests>
                <param>com.hms.*</param>
              </targetTests>
              <outputFormats>
                <param>HTML</param>
                <param>XML</param>
              </outputFormats>
              <!-- A starting line, not an aspiration. Raise it as the suite earns it; a
                   threshold set above what the suite achieves today just gets ignored. -->
              <mutationThreshold>60</mutationThreshold>
              <timeoutConstant>10000</timeoutConstant>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- API automation. Kept out of the default reactor on purpose: these tests talk HTTP to a
         deployed gateway, so an ordinary `mvn verify` on a developer machine must not try to run
         them. Reachable as `mvn -pl tests/api verify -Pautomation` (or `make test-api`). -->
    <profile>
      <id>automation</id>
      <modules>
        <module>tests/api</module>
      </modules>
    </profile>
  </profiles>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- Services boot a real Postgres/Kafka-free local profile in tests. -->
            <environmentVariables>
              <HMS_TEST>1</HMS_TEST>
            </environmentVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
