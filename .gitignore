# Java / Maven
target/
*.jar
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# Local run state (scripts/local.sh)
.run/

# Node / Next.js
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Trained model artifacts are rebuilt by services/ai-service/training
services/ai-service/models/*.joblib

# Env / secrets - never commit real credentials or signing keys
.env
.env.*
!.env.example

# Editors / OS
.idea/
.vscode/
.DS_Store
*.log

# Compiled installers (installer/windows/build.sh). A binary in the repository is a binary nobody
# can review and everybody has to trust; the downloadable .exe comes from the windows-installer
# workflow, built from this source on GitHub's own runners.
dist/

# Web
/web/.next/
/web/test-results/
/web/playwright-report/
/web/blob-report/
/web/.playwright/

# Scan and profile output (security/zap/run.sh, security/pentest/run.sh)
build/

# Development TLS material generated by scripts/gen-certs.sh - never commit a key
certs/
*.p12
*.jks
*.pem
*.key
*.crt
*.csr
*.srl
