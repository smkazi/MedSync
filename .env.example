# Copy to .env and fill in. `.env` is gitignored; this file is not, so it must never
# contain a real value.
#
#   cp .env.example .env
#   # then generate the two secrets below and paste them in
#
# There are deliberately no working defaults for the secrets. An earlier version of
# docker-compose.yml carried a literal development PHI key, which gitleaks flagged -
# correctly. A committed key is a key everyone who clones the repository shares, and a
# "development only" comment beside one does not stop it reaching a staging box that
# holds real records. `docker compose up` now refuses to start until these are set.

# ---------------------------------------------------------------------------
# Secrets. Generate, do not invent.
# ---------------------------------------------------------------------------

# AES-256 key for the encrypted patient identifiers (national id, insurance policy
# number). Must be 32 bytes, base64-encoded:
#
#   openssl rand -base64 32
#
# Losing this key makes those columns permanently unreadable. Back it up wherever you
# keep the database backups, and rotate it the same way.
HMS_PHI_KEY=

# PostgreSQL password for the `hms` role.
#
#   openssl rand -base64 24
HMS_DB_PASSWORD=

# RSA private key used to sign access tokens, PEM, PKCS#8. Optional: leave blank and
# identity-service generates a keypair on first boot and stores it in
# identity.signing_keys, which is fine for local work. Set it in any deployment where
# more than one identity-service instance runs, or tokens signed by one will be
# rejected by the others.
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | awk '{printf "%s\\n", $0}'
HMS_JWT_PRIVATE_KEY=

# Enables model-backed note summarisation. Left blank the AI service uses its
# deterministic extractive fallback, which is why the whole platform works with no
# API key and no outbound network.
HMS_AI_ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Settings. Safe defaults; change to suit.
# ---------------------------------------------------------------------------

# Seeds one demo account per role, all flagged must-change-password. Never true in a
# deployment - the accounts and their shared password are in the repository.
HMS_SEED_ENABLED=true
HMS_SEED_PASSWORD=ChangeMe!Dev2026

# Clinic-local zone. Drives slot generation, so a wrong value books appointments in
# the wrong hour rather than failing visibly.
HMS_TIMEZONE=UTC

# `kafka` in a deployment, `log` to run the whole platform on PostgreSQL alone.
HMS_EVENTS_TRANSPORT=kafka

# Per-client rate limits at the gateway, per minute. The auth bucket is what makes
# password spraying impractical; raise both for a load test or an API suite run - see
# `make dev-test-stack`.
HMS_RATE_LIMIT_ENABLED=true
HMS_RATE_LIMIT_RPM=600
HMS_RATE_LIMIT_AUTH_RPM=20
# The patient portal's own bucket. A fifth of the general limit: a patient opens their
# appointments, reads a report and pays a bill, which looks nothing like a clinician's worklist.
HMS_RATE_LIMIT_PORTAL_RPM=120

# The zone this deployment's days are bounded in. "The 14th" means the hospital's 14th,
# not the container's: a UTC container serving a hospital in Asia/Kolkata rolls the date
# over five and a half hours early. Three things bound a day -- the billing day book, the
# audit report and the disclosure register -- and each has its own override
# (HMS_BILLING_ZONE, HMS_AUDIT_ZONE, HMS_INTEROP_ZONE) that defaults from this one, so a
# deployment normally sets only this and they cannot disagree.
HMS_ZONE=Asia/Kolkata

# The database roles. By default one role does three jobs -- install extensions, run every
# migration, serve every query for all nine schemas -- which means a SQL-injection hole in
# any one service reaches every other service's tables. scripts/db-roles.sql splits that
# into hms_migrate (owns the schemas, holds DDL, Flyway's credential and only Flyway's),
# one runtime role per service, and hms_app (every schema) for a deployment that has not
# separated its services yet. Run it once as a superuser, then set these. Left unset,
# everything behaves exactly as it did before the split existed.
#HMS_DB_MIGRATION_USER=hms_migrate
#HMS_DB_MIGRATION_PASSWORD=

# The fallback runtime credential: every schema, no DDL. Used by any service whose own
# variables below are unset, so a partial migration works one service at a time.
#HMS_DB_USER=hms_app

# One credential per service, and the reason the nine roles exist: connected as hms_billing,
# an injected `SELECT ... FROM patient.patients` in billing-service is refused by PostgreSQL
# with "permission denied for schema patient" rather than by billing-service remembering not
# to ask for it.
#
# Give each a DIFFERENT password. Nine roles behind one secret is nine sets of privileges and
# one credential to steal: the privilege split survives that, the credential split does not.
# scripts/db-roles.sql names every service still sharing a password when it finishes.
#HMS_DB_IDENTITY_USER=hms_identity
#HMS_DB_IDENTITY_PASSWORD=
#HMS_DB_PATIENT_USER=hms_patient
#HMS_DB_PATIENT_PASSWORD=
#HMS_DB_SCHEDULING_USER=hms_scheduling
#HMS_DB_SCHEDULING_PASSWORD=
#HMS_DB_LABORATORY_USER=hms_laboratory
#HMS_DB_LABORATORY_PASSWORD=
#HMS_DB_NOTIFICATION_USER=hms_notification
#HMS_DB_NOTIFICATION_PASSWORD=
#HMS_DB_ADMISSIONS_USER=hms_admissions
#HMS_DB_ADMISSIONS_PASSWORD=
#HMS_DB_PHARMACY_USER=hms_pharmacy
#HMS_DB_PHARMACY_PASSWORD=
#HMS_DB_BILLING_USER=hms_billing
#HMS_DB_BILLING_PASSWORD=
#HMS_DB_INTEROP_USER=hms_interop
#HMS_DB_INTEROP_PASSWORD=

# How long a session may sit idle before it has to be signed into again, and the outer bound
# it ends at however active it is. The second is not redundant: the refresh token's own expiry
# is re-set on every rotation, so without an absolute bound a session refreshed once a day
# never ends. A portal account gets the shorter idle bound - those sessions are opened on
# shared and family machines far more often than a clinical workstation is.
HMS_SESSION_IDLE_TIMEOUT=PT30M
HMS_SESSION_PORTAL_IDLE_TIMEOUT=PT15M
HMS_SESSION_MAX_LIFETIME=P7D

# Browser origin allowed through CORS.
HMS_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set true once TLS terminates in front of the web tier, so the session cookie is
# marked Secure. Leaving it false over HTTPS means the cookie travels without that
# flag.
COOKIE_SECURE=false

# ---- Outbound messaging (notification-service) -------------------------------
#
# All optional, and every one of them unset is a working deployment: the module composes
# each message, records it in the delivery log, and sends nothing - saying plainly in the
# row why. Nothing here has a committed default, because a mail password, a gateway key
# and a service-account password are all credentials.

# Where a message tells the patient to go. Every message ends in this link and says
# nothing else about what is waiting there.
HMS_PORTAL_URL=http://localhost:3000

# The service account notification-service signs in as to look up where to send a
# message. It holds the SERVICE role, which reads a phone number and an email address
# and no part of a chart. Unset means no contact lookup at all.
HMS_NOTIFICATION_ACCOUNT=svc.notification
HMS_NOTIFICATION_PASSWORD=

# Email. Plain SMTP, so any mail server the deployment already runs works; without a
# host the email channel does not exist.
HMS_SMTP_HOST=
HMS_SMTP_PORT=587
HMS_SMTP_USER=
HMS_SMTP_PASSWORD=
HMS_NOTIFICATION_FROM=no-reply@localhost

# SMS, or anything else reached by an HTTP POST. Deliberately generic: every gateway
# takes a different body, so the field names are configuration rather than a vendor
# choice compiled into the platform. Unset means the SMS channel does not exist.
HMS_SMS_URL=
HMS_SMS_TO_FIELD=to
HMS_SMS_TEXT_FIELD=text
HMS_SMS_AUTH_HEADER=Authorization
HMS_SMS_AUTH_VALUE=

# Which channel the event-driven path asks for. LOG until there is somewhere real to
# send; an unconfigured channel falls back to the log rather than failing a release.
HMS_NOTIFICATION_CHANNEL=LOG

# ---- billing ---------------------------------------------------------------
# The zone a day is cashed up in, and the prefix invoice numbers carry. Both are a
# deployment's own: a payment's timestamp is an instant, and "the 14th" is a different
# window in Kolkata than in UTC, so a hospital counting its drawer at eight in the
# evening would otherwise find that evening's takings in tomorrow.
HMS_BILLING_ZONE=Asia/Kolkata
HMS_INVOICE_PREFIX=INV

# Which charge item each clinical event is billed as. These are the codes the seed
# migration ships; a deployment with its own charge list points them at its own codes
# rather than editing Java. A code naming nothing in the charge list is reported in the
# log and charged to nobody -- never guessed at.
HMS_CHARGE_CONSULTATION=CONSULT_OP
HMS_CHARGE_CASUALTY=CASUALTY
HMS_CHARGE_LAB_PREFIX=LAB_
HMS_CHARGE_LAB_FALLBACK=LAB_PANEL
HMS_CHARGE_DISPENSE=PHARM_DISP
HMS_CHARGE_BED_DAY=BED_GEN

# ---- interoperability (ABDM, FHIR) -----------------------------------------
# What this deployment calls itself in a FHIR bundle and in an ABDM handshake. No hospital
# name enters this repository, so the default says plainly that nobody has set one.
HMS_FACILITY_NAME=An unnamed clinical establishment
HMS_FACILITY_ID=UNSET

# Where a bundle goes when it leaves. LOG records what would have been sent and sends
# nothing -- the honest default for a deployment with no NHA credentials. HTTP posts to
# HMS_ABDM_GATEWAY_URL, which is a place for the real ABDM data-flow to be implemented
# against a sandbox rather than a claim that it has been. See the README.
HMS_ABDM_GATEWAY=LOG
HMS_ABDM_GATEWAY_URL=
HMS_ABDM_GATEWAY_AUTH_HEADER=Authorization
HMS_ABDM_GATEWAY_AUTH_VALUE=

# The longest a consent may be granted for. Permission to read somebody's medical record is
# not the kind of thing to grant open-endedly by typing a date.
HMS_MAX_CONSENT_DAYS=180
